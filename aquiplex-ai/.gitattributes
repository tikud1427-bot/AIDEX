# ── Line endings ─────────────────────────────────────────────────────────────
#
# A Windows round-trip of this repo rewrote 121 files from LF to CRLF with ZERO
# content changes. Committed, that is a 121-file diff burying whatever real edit
# it travelled with, and `git blame` pointing at the conversion for every line.
#
# `text=auto eol=lf` normalises to LF in the object store while leaving working
# copies alone, so the checkout stays native and the history stays readable.
* text=auto eol=lf

# Never touched: a CRLF in a shell script breaks the shebang, and a rewritten
# byte in a binary corrupts it.
*.sh   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.gz   binary
*.zip  binary
