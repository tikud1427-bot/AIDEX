<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Aqua" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/aqua_primary</item>
        <item name="android:windowBackground">@color/aqua_background</item>
        <item name="android:statusBarColor">@color/aqua_background</item>
        <item name="android:navigationBarColor">@color/aqua_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Android 12+ SplashScreen API, back-compat via androidx.core:core-splashscreen.
         Applied to the app while it cold-starts, then swaps to Theme.Aqua automatically. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aqua_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Aqua</item>
    </style>

</resources>
